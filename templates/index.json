    "comparison_table_FkP9tn": {
      "type": "comparison-table",
      "blocks": {
        "heading_row_gPHUkc": {
          "type": "heading_row",
          "settings": {
            "cell_1_highlight": false,
            "cell_1_content": "<p>Cheap tubs</p>",
            "cell_2_highlight": true,
            "cell_2_content": "<p>ONZEN</p>",
            "cell_3_highlight": false,
            "cell_3_content": "<p>Other premium tubs</p>"
          }
        },
        "row_LVeVXy": {
          "type": "row",
          "settings": {
            "title": "Price",
            "cell_1_highlight": false,
            "cell_1_icon": "check",
            "cell_1_content": "<p>$2,000-$5,000</p>",
            "cell_2_highlight": true,
            "cell_2_icon": "check",
            "cell_2_content": "<p>$7,999</p>",
            "cell_3_highlight": false,
            "cell_3_icon": "cross",
            "cell_3_content": "<p>$8,600+</p>"
          }
        },
        "row_D48r9G": {
          "type": "row",
          "settings": {
            "title": "Package",
            "cell_1_highlight": false,
            "cell_1_icon": "cross",
            "cell_1_content": "<p>Accessories often sold <br/>separately at additional cost.</p>",
            "cell_2_highlight": true,
            "cell_2_icon": "check",
            "cell_2_content": "<p>Comes with everything you need -  including one spare filter.</p>",
            "cell_3_highlight": false,
            "cell_3_icon": "cross",
            "cell_3_content": "<p>Accessories often sold separately at additional cost.</p>"
          }
        },
        "row_dhGWcp": {
          "type": "row",
          "settings": {
            "title": "Materials & Build Quality",
            "cell_1_highlight": false,
            "cell_1_icon": "cross",
            "cell_1_content": "<p>Cheap, flimsy inflatable PVC, sometimes requiring plastic support props.</p>",
            "cell_2_highlight": true,
            "cell_2_icon": "check",
            "cell_2_content": "<p>Lightweight, durable, premium Japanese Mizuburo Acrylic reinforced with fiberglass for added strength. Built to last a lifetime.</p>",
            "cell_3_highlight": false,
            "cell_3_icon": "cross",
            "cell_3_content": "<p>Acrylic material varies, with some made from cheap plastic compound Acrylonitrile Butadiene Styrene, causing discoloration of tub over time.</p>"
          }
        },
        "row_f4DANB": {
          "type": "row",
          "settings": {
            "title": "Cooling technology",
            "cell_1_highlight": false,
            "cell_1_icon": "cross",
            "cell_1_content": "<p>External, non-integrated cooling systems that lack power efficiency and have limited cooling capacity, leading to longer wait times to reach desired temperatures.</p>",
            "cell_2_highlight": false,
            "cell_2_icon": "check",
            "cell_2_content": "<p>Fully-integrated, proprietary and highly advanced 1.5HP medical-grade cooling system, similar to those used in hospitals and semiconductor manufacturing facilities.</p>",
            "cell_3_highlight": false,
            "cell_3_icon": "check",
            "cell_3_content": "<p>Fully-integrated, efficient, and rapid cooling systems, but may not utilize medical-grade cooling technology, which ensures reliability and precision in every application.</p>"
          }
        },
        "row_kbDEPW": {
          "type": "row",
          "settings": {
            "title": "Control Unit",
            "cell_1_highlight": false,
            "cell_1_icon": "cross",
            "cell_1_content": "<p>Out-of-date control units that utilize basic technology, which may lead to  long-term reliability and durability issues.</p>",
            "cell_2_highlight": false,
            "cell_2_icon": "check",
            "cell_2_content": "<p>Official Sony electronic control unit, designed for medical applications. Our latest Sony microcontrollers ensure the electronic components don’t break under cold or heat stress. It is also 100% waterproof, enhancing durability and safety.</p>",
            "cell_3_highlight": false,
            "cell_3_icon": "check",
            "cell_3_content": "<p>Advanced electronic control units. Usually waterproof and built to endure extreme temperature variations.</p>"
          }
        },
        "row_EtmJjJ": {
          "type": "row",
          "settings": {
            "title": "Shipping & Taxes",
            "cell_1_highlight": false,
            "cell_1_icon": "cross",
            "cell_1_content": "<p>Varies</p>",
            "cell_2_highlight": true,
            "cell_2_icon": "check",
            "cell_2_content": "<p>Free global express shipping. All taxes included.</p>",
            "cell_3_highlight": false,
            "cell_3_icon": "cross",
            "cell_3_content": "<p>Varies</p>"
          }
        },
        "row_NRBf6A": {
          "type": "row",
          "settings": {
            "title": "Returns",
            "cell_1_highlight": false,
            "cell_1_icon": "cross",
            "cell_1_content": "<p>Varies</p>",
            "cell_2_highlight": true,
            "cell_2_icon": "check",
            "cell_2_content": "<p>30-Day <a href=\"/policies/refund-policy\" target=\"_blank\" title=\"Refund Policy\">Refund Policy</a>.</p>",
            "cell_3_highlight": false,
            "cell_3_icon": "cross",
            "cell_3_content": "<p>Varies</p>"
          }
        },
        "row_FXdh6H": {
          "type": "row",
          "settings": {
            "title": "Warranty",
            "cell_1_highlight": false,
            "cell_1_icon": "cross",
            "cell_1_content": "<p>Usually no warranty.</p>",
            "cell_2_highlight": true,
            "cell_2_icon": "check",
            "cell_2_content": "<p>5-Year full product warranty.</p>",
            "cell_3_highlight": false,
            "cell_3_icon": "check",
            "cell_3_content": "<p>Varies, usually 2-3 years</p>"
          }
        }
      },
