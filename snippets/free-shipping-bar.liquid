{{ 'component-custom-progress-bar.css' | asset_url | stylesheet_tag }}

{%- if settings.enable_free_shipping_bar -%}
  {%- if settings.free_shipping_bar_limit != blank and settings.free_shipping_bar_limit contains ',' -%}
    {%- assign limit_split = settings.free_shipping_bar_limit | split: ',' -%}
    {%- if shop.enabled_currencies.size > 1 -%}
      {% for currency in limit_split %}
        {% if currency contains cart.currency.iso_code %}
          {% assign threshold_raw = currency | split: ':' %}
          {%- assign limit = threshold_raw[1] | strip -%}
          {{ limit }}
          {%- break -%}
        {% endif %}
      {% endfor %}
    {%- else -%}
      {%- assign limit = limit_split[0] -%}
    {%- endif -%}
  {%- else -%}
    {%- assign limit = settings.free_shipping_bar_limit | default: 0 -%}
  {%- endif -%}
  {%- assign left_to_spend = limit | minus: cart.total_price | at_least: 0 -%}

  <free-shipping-bar
    data-threshold="{{ limit }}"
    style="
      --progress-range-color: {{ settings.free_shipping_bar_range_bg.rgb }};
      --progress-thumb-color: {{ settings.free_shipping_bar_thumb_bg.rgb }};
    "
    class="
      custom-progress-bar
      {% unless left_to_spend > 0 %} custom-progress-bar--completed{% endunless %}
      {{ class }}
    "
  >
    <div class="custom-progress-bar__status">
      <strong class="custom-progress-bar__message" progress-bar-message>
        {%- if left_to_spend > 0 -%}
          {%- assign left_to_spend_money = left_to_spend | money -%}
          {{ 'sections.free_shipping_bar.free_shipping_text_html' | t: value: left_to_spend_money }}
        {%- else -%}
          {{ 'sections.free_shipping_bar.free_shipping_success_text_html' | t }}
        {%- endif -%}
      </strong>
    </div>
    <div class="custom-progress-bar__progress">
      {%- assign range_quotient = limit | times: 1.0 | divided_by: 100 -%}
      {%- assign range_procent = cart.total_price | divided_by: range_quotient | at_most: 100 -%}
      <div class="custom-progress-bar__thumb" progress-bar-thumb style="width: {{ range_procent }}%;"></div>
    </div>
  </free-shipping-bar>
{%- endif -%}
