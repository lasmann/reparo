{% assign full_star_count = star_rating | floor %}
{% assign fractional_part = star_rating | modulo: 1 %}
{% assign empty_star_count = 5 | minus: star_rating | floor %}

<div class="star-rating" style="display: flex; gap: 4px;">
  <!-- Render full stars -->
  {% for i in (1..full_star_count) %}
    <span class="svg-wrapper">
      <svg
        class="icon icon--star"
        width="22"
        height="22"
        viewBox="0 0 22 22"
        fill="rgb(var(--color-star-rating))"
        xmlns="http://www.w3.org/2000/svg"
      >
        <path d="M8.15299 4.408C9.41999 2.136 10.053 1 11 1C11.947 1 12.58 2.136 13.847 4.408L14.175 4.996C14.535 5.642 14.715 5.965 14.995 6.178C15.275 6.391 15.625 6.47 16.325 6.628L16.961 6.772C19.421 7.329 20.65 7.607 20.943 8.548C21.235 9.488 20.397 10.469 18.72 12.43L18.286 12.937C17.81 13.494 17.571 13.773 17.464 14.117C17.357 14.462 17.393 14.834 17.465 15.577L17.531 16.254C17.784 18.871 17.911 20.179 17.145 20.76C16.379 21.341 15.227 20.811 12.925 19.751L12.328 19.477C11.674 19.175 11.347 19.025 11 19.025C10.653 19.025 10.326 19.175 9.67199 19.477L9.07599 19.751C6.77299 20.811 5.62099 21.341 4.85599 20.761C4.08899 20.179 4.21599 18.871 4.46899 16.254L4.53499 15.578C4.60699 14.834 4.64299 14.462 4.53499 14.118C4.42899 13.773 4.18999 13.494 3.71399 12.938L3.27999 12.43C1.60299 10.47 0.764991 9.489 1.05699 8.548C1.34899 7.607 2.57999 7.328 5.03999 6.772L5.67599 6.628C6.37499 6.47 6.72399 6.391 7.00499 6.178C7.28599 5.965 7.46499 5.642 7.82499 4.996L8.15299 4.408Z" stroke="rgb(var(--color-star-rating))" stroke-width="1.5" />
      </svg>
    </span>
  {% endfor %}

  <!-- Render partial star if applicable -->
  {% if fractional_part > 0 %}
    {% assign unique_id = 'partial_fill_' | append: forloop.index %}
    {% assign fill_percentage = fractional_part | times: 100 | floor %}
    <span class="svg-wrapper">
      <svg class="icon icon--star" width="22" height="22" viewBox="0 0 22 22" xmlns="http://www.w3.org/2000/svg">
        <defs>
          <linearGradient id="{{ unique_id }}">
            <stop offset="{{ fill_percentage }}%" stop-color="rgb(var(--color-star-rating))" />
            <stop offset="{{ fill_percentage }}%" stop-color="transparent" />
          </linearGradient>
        </defs>
        <path d="M8.15299 4.408C9.41999 2.136 10.053 1 11 1C11.947 1 12.58 2.136 13.847 4.408L14.175 4.996C14.535 5.642 14.715 5.965 14.995 6.178C15.275 6.391 15.625 6.47 16.325 6.628L16.961 6.772C19.421 7.329 20.65 7.607 20.943 8.548C21.235 9.488 20.397 10.469 18.72 12.43L18.286 12.937C17.81 13.494 17.571 13.773 17.464 14.117C17.357 14.462 17.393 14.834 17.465 15.577L17.531 16.254C17.784 18.871 17.911 20.179 17.145 20.76C16.379 21.341 15.227 20.811 12.925 19.751L12.328 19.477C11.674 19.175 11.347 19.025 11 19.025C10.653 19.025 10.326 19.175 9.67199 19.477L9.07599 19.751C6.77299 20.811 5.62099 21.341 4.85599 20.761C4.08899 20.179 4.21599 18.871 4.46899 16.254L4.53499 15.578C4.60699 14.834 4.64299 14.462 4.53499 14.118C4.42899 13.773 4.18999 13.494 3.71399 12.938L3.27999 12.43C1.60299 10.47 0.764991 9.489 1.05699 8.548C1.34899 7.607 2.57999 7.328 5.03999 6.772L5.67599 6.628C6.37499 6.47 6.72399 6.391 7.00499 6.178C7.28599 5.965 7.46499 5.642 7.82499 4.996L8.15299 4.408Z"
          fill="url(#{{ unique_id }})" stroke-width="1.5" stroke="rgb(var(--color-star-rating))" />
      </svg>
    </span>
  {% endif %}

  <!-- Render empty stars -->
  {% for i in (1..empty_star_count) %}
    <span class="svg-wrapper">
      <svg
        class="icon icon--star"
        width="22"
        height="22"
        viewBox="0 0 22 22"
        fill="none"
        xmlns="http://www.w3.org/2000/svg"
      >
        <path d="M8.15299 4.408C9.41999 2.136 10.053 1 11 1C11.947 1 12.58 2.136 13.847 4.408L14.175 4.996C14.535 5.642 14.715 5.965 14.995 6.178C15.275 6.391 15.625 6.47 16.325 6.628L16.961 6.772C19.421 7.329 20.65 7.607 20.943 8.548C21.235 9.488 20.397 10.469 18.72 12.43L18.286 12.937C17.81 13.494 17.571 13.773 17.464 14.117C17.357 14.462 17.393 14.834 17.465 15.577L17.531 16.254C17.784 18.871 17.911 20.179 17.145 20.76C16.379 21.341 15.227 20.811 12.925 19.751L12.328 19.477C11.674 19.175 11.347 19.025 11 19.025C10.653 19.025 10.326 19.175 9.67199 19.477L9.07599 19.751C6.77299 20.811 5.62099 21.341 4.85599 20.761C4.08899 20.179 4.21599 18.871 4.46899 16.254L4.53499 15.578C4.60699 14.834 4.64299 14.462 4.53499 14.118C4.42899 13.773 4.18999 13.494 3.71399 12.938L3.27999 12.43C1.60299 10.47 0.764991 9.489 1.05699 8.548C1.34899 7.607 2.57999 7.328 5.03999 6.772L5.67599 6.628C6.37499 6.47 6.72399 6.391 7.00499 6.178C7.28599 5.965 7.46499 5.642 7.82499 4.996L8.15299 4.408Z" stroke-width="1.5" stroke="rgb(var(--color-star-rating))"/>
      </svg>
    </span>
  {% endfor %}
</div>
