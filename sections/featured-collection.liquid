{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}

{{ 'component-slider.css' | asset_url | stylesheet_tag }}
{{ 'template-collection.css' | asset_url | stylesheet_tag }}

{% if section.settings.image_shape == 'blob' %}
  {{ 'mask-blobs.css' | asset_url | stylesheet_tag }}
{%- endif -%}

{%- unless section.settings.quick_add == 'none' -%}
  {{ 'quick-add.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
{%- endunless -%}

{%- if section.settings.quick_add == 'standard' -%}
  <script src="{{ 'quick-add.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{%- if section.settings.quick_add == 'bulk' -%}
  <script src="{{ 'quick-add-bulk.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'quantity-popover.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'price-per-item.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'quick-order-list.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{%- style -%}
  #shopify-section-{{ section.id }} {
    overflow: hidden;
  }

    .swiper-scrollbar,
    .swiper-pagination {
      display: flex !important;
    }
    .section-{{ section.id }}-padding {
      padding-top: calc({{ section.settings.padding_top }}px * 0.75);
      padding-bottom: calc({{ section.settings.padding_bottom }}px  * 0.75);
    }

    @media screen and (min-width: 750px) {
      .section-{{ section.id }}-padding {
        padding-top: {{ section.settings.padding_top }}px;
        padding-bottom: {{ section.settings.padding_bottom }}px;
      }
    }
{%- endstyle -%}

{%- capture slider_options -%}
    {
    {% if section.settings.slider_loop %}
    'loop': true,
    'loopAddBlankSlides': true,
    {% endif %}
    {% unless section.settings.slider_effect == 'default' and section.settings.slider_mobile_slides_count > 1 %}
    'effect': '{{ section.settings.slider_effect }}',
    'crossFade': false,
    {% endunless %}
    'speed': {{ section.settings.slider_speed | times: 100 }},
    'autoplay': false,
    'grabCursor': true,
    'slidesPerView': {{ section.settings.slider_mobile_slides_count }},
    {% if section.settings.slider_grouped_slides %}
    'slidesPerGroup': {{ section.settings.slider_mobile_slides_count }},
    {% endif %}
    'centeredSlides': {{ section.settings.slider_mobile_center_slides }},
    'spaceBetween': {{ section.settings.slider_mobile_slides_gap }},
    'mousewheel': {
      'forceToAxis': true,
      'thresholdDelta': 20
    },
    {% if section.settings.slider_enable_navigation %}
    'navigation': {
      'prevEl': '#swiper-prev-button--{{ section.id }}',
      'nextEl': '#swiper-next-button--{{ section.id }}'
    },
    {% endif %}
    'breakpoints': {
        '750': {
          {% unless section.settings.slider_effect == 'default' and section.settings.slider_tablet_slides_count > 1 %}
          'effect': '{{ section.settings.slider_effect }}',
          'crossFade': false,
          {% endunless %}
          'slidesPerView': {{ section.settings.slider_tablet_slides_count }},
          {% if section.settings.slider_grouped_slides %}
          'slidesPerGroup': {{ section.settings.slider_tablet_slides_count }},
          {% endif %}
          'spaceBetween': {{ section.settings.slider_tablet_slides_gap }},
          'centeredSlides': {{ section.settings.slider_tablet_center_slides }}
        },
        '1200': {
          {% unless section.settings.slider_effect == 'default' and section.settings.slider_desktop_slides_count > 1 %}
          'effect': '{{ section.settings.slider_effect }}',
          'crossFade': false,
          {% endunless %}
          {% if section.settings.slider_grouped_slides %}
          'slidesPerGroup': {{ section.settings.slider_desktop_slides_count }},
          {% endif %}
          'slidesPerView': {{ section.settings.slider_desktop_slides_count }},
          'spaceBetween': {{ section.settings.slider_desktop_slides_gap }},
          'centeredSlides': {{ section.settings.slider_desktop_center_slides }}
        }
    },
    {%- if section.settings.slider_pagination == 'bullets' -%}
      'pagination': {
        'el': '#swiper-pagination--{{ section.id }}'
      }
    {%- elsif section.settings.slider_pagination == 'dynamic-bullets' -%}
      'pagination': {
        'el': '#swiper-pagination--{{ section.id }}',
        'dynamicBullets': true
      }
    {%- elsif section.settings.slider_pagination == 'progress' -%}
      'scrollbar': {
        'el': '#swiper-scrollbar--{{ section.id }}'
      }
    {%- endif -%}
    }
  {%- endcapture -%}

{% capture section_slides %}
    {% assign skip_card_product_styles = false %}
    {% if section.settings.collection != blank %}
    {%- for product in section.settings.collection.products -%}
      <li
        id="Slide-{{ section.id }}-{{ forloop.index }}"
        class="swiper-slide {% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
        data-swiper-slide
        {% if settings.animations_reveal_on_scroll %}
          data-cascade
          style="--animation-order: {{ forloop.index }};"
        {% endif %}
      >
        {% render 'card-product',
          card_product: product,
          media_aspect_ratio: section.settings.image_ratio,
          image_shape: section.settings.image_shape,
          show_secondary_image: section.settings.show_secondary_image,
          show_vendor: section.settings.show_vendor,
          show_rating: section.settings.show_rating,
          skip_styles: skip_card_product_styles,
          section_id: section.id,
          quick_add: section.settings.quick_add
        %}
      </li>
      {%- endfor -%}
      {%- else -%}
      {%- assign skip_card_product_styles = true -%}
      {%- for i in (1..section.settings.slider_desktop_slides_count) -%}
        <li
        data-swiper-slide
          class="swiper-slide {% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
          {% if settings.animations_reveal_on_scroll %}
            data-cascade
            style="--animation-order: {{ forloop.index }};"
          {% endif %}
        >
          {% liquid
            assign ridx = forloop.rindex
            case ridx
              when 5
                assign ridx = 1
              when 6
                assign ridx = 2
            endcase
          %}
          {%- assign placeholder_image = 'product-apparel-' | append: ridx -%}
          {% render 'card-product',
            show_vendor: section.settings.show_vendor,
            media_aspect_ratio: section.settings.image_ratio,
            image_shape: section.settings.image_shape,
            placeholder_image: placeholder_image
          %}
        </li>
      {%- endfor -%}
    {%- endif -%}
  {% endcapture %}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="section-{{ section.id }}-padding scroll-trigger animate--slide-in">
    <div class="page-width {% if section.settings.full_width %} page-width--full-width {% endif %}">
      {% render 'section-header',
        heading: section.settings.heading,
        heading_size: section.settings.heading_size,
        heading_weight: section.settings.heading_weight,
        heading_html_tag: section.settings.heading_html_tag,
        desktop_content_position: section.settings.desktop_content_alignment,
        content_content_position: section.settings.content_alignment
      %}
      <div class="slider-wrapper {% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
        <swiper-slider
          class="testimonial-slider testimonial-slider--{{section.id}}"
          data-options="{{ slider_options }}"
        >
          <div
            class="swiper {% unless section.settings.slider_clip_contents %} swiper--no-clip {% endunless %}"
            data-swiper
          >
            <ul class="swiper-wrapper list-unstyled">
              {{ section_slides }}
            </ul>
          </div>
        </swiper-slider>
        <div class="slider-wrapper__navigation">
          <button id="swiper-prev-button--{{ section.id }}" class="swiper-button full-unstyled-button" data-type="prev">
            {{- 'icon-arrow.svg' | inline_asset_content -}}
          </button>
          <button id="swiper-next-button--{{ section.id }}" class="swiper-button full-unstyled-button" data-type="next">
            {{- 'icon-arrow.svg' | inline_asset_content -}}
          </button>
        </div>
        {% if section.settings.slider_pagination == 'progress' %}
          <div
            class="slider-wrapper__pagination swiper-pagination-nav swiper-scrollbar"
            id="swiper-scrollbar--{{ section.id }}"
          ></div>
        {% else %}
          <div class="slider-wrapper__pagination swiper-pagination-nav" id="swiper-pagination--{{ section.id }}"></div>
        {% endif %}
      </div>
    </div>
  </div>
</div>

