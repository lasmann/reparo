{{ 'component-accordion.css' | asset_url | stylesheet_tag }}
{{ 'collapsible-content.css' | asset_url | stylesheet_tag }}

{%- style -%}
  #shopify-section-{{ section.id }} .collapsible-content__grid {
    --grid-desktop-vertical-spacing: {{ section.settings.layout_grid_gap }}px;
    --grid-desktop-horizontal-spacing: {{ section.settings.layout_grid_gap }}px;
    --grid-mobile-vertical-spacing: {{ section.settings.layout_grid_gap | times: 0.75 | round: 0  }}px;
    --grid-mobile-horizontal-spacing: {{ section.settings.layout_grid_gap | times: 0.75 | round: 0  }}px;
  }

  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{% comment %}
  TODO:
   - Allow merchants to switch between icon-caret and icon-plus-minus for accordions [theme-settings?].
   - Allow merchants to disable accordion animations by removing the ‘animate’ attribute [theme-settings?].
   - Clean up markup and collapsible-content.css.
   - Ensure full responsiveness for different accordion sizes.
   - Let’s add a checkbox “Full width image on mobile”. When enabled, add a class like
   ‘.media—mobile-full-width’ with the style property margin-inline: calc(-1 * var(-—page-width-padding)).
   Also, ensure the section has overflow: hidden if “Full width image on mobile” is enabled.

   🎙️: White Eagle. Over.
{% endcomment %}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="section-{{ section.id }}-padding">
    <div class="{{ section.settings.section_width }} collapsible-content">
      {% render 'section-header',
        class: 'collapsible-content__header',
        heading: section.settings.heading,
        heading_size: section.settings.heading_size,
        heading_weight: section.settings.heading_weight,
        heading_html_tag: section.settings.heading_html_tag,
        desktop_content_position: section.settings.header_desktop_content_alignment,
        content_content_position: section.settings.header_content_alignment
      %}
      <div class="grid grid--1-col grid--2-col-tablet collapsible-content__grid{% if section.settings.desktop_layout == 'image_second' %} collapsible-content__grid--reverse{% endif %}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
        {%- if section.settings.image != blank -%}
          {% unless section.settings.section_width contains 'narrow' %}
            <div class="grid__item collapsible-content__grid-item">
              <div
                class="collapsible-content__media media media--{{ section.settings.image_ratio }} global-media-settings gradient"
                {% if section.settings.image_ratio == 'adapt' %}
                  style="padding-bottom: {{ 1 | divided_by: section.settings.image.aspect_ratio | times: 100 }}%;"
                {% endif %}
              >
                {% liquid
                  capture sizes
                    render 'sizes-attribute'
                  endcapture

                  render 'image', image: section.settings.image, widths: '460, 535, 750, 1070, 1500, 1700, 1900, 2100', src_width: 2100, sizes: sizes
                %}
              </div>
            </div>
          {% endunless %}
        {% endif %}
        <div class="grid__item">
          {%- for block in section.blocks -%}
            {% assign first_accord_open = false %}
            {% if section.settings.open_first_collapsible_row and forloop.first %}
              {% assign first_accord_open = true %}
            {% endif %}
            {% render 'custom-accordion',
              is_open: first_accord_open,
              accordion_id: block.id,
              size: section.settings.accordions_size,
              heading: block.settings.heading,
              content: block.settings.content,
              page_content: block.settings.page_content,
              custom_icon: block.settings.icon,
              block_attributes: block.shopify_attributes
            %}
          {%- endfor -%}
        </div>
      </div>
    </div>
  </div>
</div>

