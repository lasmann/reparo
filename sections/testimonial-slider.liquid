{{ 'section-testimonial-slider.css' | asset_url | stylesheet_tag }}
{{ 'component-testimonial-card.css' | asset_url | stylesheet_tag }}

{%- style -%}
    #shopify-section-{{ section.id }} {
    overflow: hidden;
  }

    .swiper-scrollbar,
    .swiper-pagination {
      display: flex !important;
    }
    .section-{{ section.id }}-padding {
      padding-top: calc({{ section.settings.padding_top }}px * 0.75);
      padding-bottom: calc({{ section.settings.padding_bottom }}px  * 0.75);
    }

    @media screen and (min-width: 750px) {
      .section-{{ section.id }}-padding {
        padding-top: {{ section.settings.padding_top }}px;
        padding-bottom: {{ section.settings.padding_bottom }}px;
      }
    }
{%- endstyle -%}

{%- capture slider_options -%}
    {
    {% if section.settings.slider_loop %}
    'loop': true,
    {% endif %}
    {% unless section.settings.slider_effect == 'default' %}
    'effect': '{{ section.settings.slider_effect }}',
    'crossFade': true,
    {% endunless %}
    'speed': {{ section.settings.slider_speed | times: 100 }},
    'loop': true,
    'autoplay': false,
    'grabCursor': true,
    'initialSlide': 0,
    'slidesPerView': 1,
    'centeredSlides': false,
    'spaceBetween': 12,
    'mousewheel': {
      'forceToAxis': true,
      'thresholdDelta': 35
    },
    {%- if section.settings.slider_pagination == 'bullets' -%}
      'pagination': {
        'el': '#swiper-pagination--{{ section.id }}'
      }
    {%- elsif section.settings.slider_pagination == 'dynamic-bullets' -%}
      'pagination': {
        'el': '#swiper-pagination--{{ section.id }}',
        'dynamicBullets': true
      }
    {%- elsif section.settings.slider_pagination == 'progress' -%}
      'scrollbar': {
        'el': '#swiper-scrollbar--{{ section.id }}'
      }
    {%- endif -%}
    }
  {%- endcapture -%}

{% capture section_slides %}
    {% for block in section.blocks %}
        {% case block.type %}
        {% when 'testimonial' %}
            <li class="swiper-slide" data-swiper-slide>
                {% render 'testimonial-card' 
                    testimonial_class: section.settings.blocks_content_alignment,
                    avatar_image: block.settings.image,
                    author_info: block.settings.title,
                    star_rating_enabled: true,
                    star_rating_text_enabled: true,
                    star_rating: block.settings.star_rating,
                    review_text: block.settings.review_text,
                    review_text_size: section.settings.blocks_text_size,
                    heading_weight: section.settings.blocks_heading_weight,
                    linked_product: block.settings.linked_product
                %}
            </li>
        {% endcase %}
    {% endfor %}
  {% endcapture %}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="section-{{ section.id }}-padding scroll-trigger animate--slide-in">
    <div class="page-width">
      {% render 'section-header',
        heading: section.settings.heading,
        heading_size: section.settings.heading_size,
        heading_weight: section.settings.heading_weight,
        heading_html_tag: section.settings.heading_html_tag,
        desktop_content_position: section.settings.desktop_content_alignment,
        content_content_position: section.settings.content_alignment
      %}
      <div class="slider-wrapper {% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
        <swiper-slider
          class="testimonial-slider testimonial-slider--{{section.id}}"
          data-options="{{ slider_options }}"
        >
          <div class="swiper overflow-visible" data-swiper>
            <ul class="swiper-wrapper list-unstyled">
              {{ section_slides }}
            </ul>
          </div>
        </swiper-slider>
        {% if section.settings.slider_pagination == 'progress' %}
          <div class="swiper-pagination-nav swiper-scrollbar" id="swiper-scrollbar--{{ section.id }}"></div>
        {% else %}
          <div class="swiper-pagination-nav" id="swiper-pagination--{{ section.id }}"></div>
        {% endif %}
      </div>
    </div>
  </div>
</div>

