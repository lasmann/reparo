{{ 'component-comparison-table.css' | asset_url | stylesheet_tag }}

<style>
  .section-{{ section.id }}-padding {
    padding-top: calc({{ section.settings.padding_top }}px * 0.75);
    padding-bottom: calc({{ section.settings.padding_bottom }}px * 0.75);
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .comparison-table {
    width: 100%;
    border-collapse: collapse;
  }

  .comparison-table th,
  .comparison-table td {
    border: 1px solid #ddd;
    padding: 10px;
    text-align: center;
  }

  .comparison-table th {
    position: sticky;
    top: 0;
    background-color: var(--color-heading-bg, #f9f9f9);
    z-index: 2;
  }

  .comparison-table__cell--highlighted {
    background-color: var(--highlight-color, #f0f8ff);
    font-weight: bold;
  }

  .section-title-wrapper {
    text-align: center;
    margin-bottom: 20px;
  }

  .section-title {
    margin: 0;
  }
</style>

<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="section-{{ section.id }}-padding">
    <div class="page-width {% if section.settings.full_width %} page-width--full-width {% endif %}">
      {% render 'section-header',
        heading: section.settings.heading,
        heading_size: section.settings.heading_size,
        heading_weight: section.settings.heading_weight,
        heading_html_tag: section.settings.heading_html_tag,
        desktop_content_position: section.settings.header_desktop_content_alignment,
        content_content_position: section.settings.header_content_alignment
      %}

      <table class="comparison-table">
        <thead>
          {% for block in section.blocks %}
            {% if block.type == 'heading_row' %}
              <tr>
                <th></th>
                {% for i in (1..3) %}
                  {% assign content_setting = 'cell_' | append: forloop.index | append: '_content' %}
                  {% assign highlight_setting = 'cell_' | append: forloop.index | append: '_highlight' %}
                  <th class="{% if block.settings[highlight_setting] %}comparison-table__cell--highlighted{% endif %}">
                    <div class="rte text-body text-body--extra-large text-bold">
                      {{ block.settings[content_setting] }}
                    </div>
                  </th>
                {% endfor %}
              </tr>
            {% endif %}
          {% endfor %}
        </thead>
        <tbody>
          {% for block in section.blocks %}
            {% if block.type == 'row' %}
              <tr>
                <td class="comparison-table__cell comparison-table__cell--heading">
                  <h4 class="text-body text-body--larger text-medium text--no-margin">{{ block.settings.title }}</h4>
                </td>
                {% for i in (1..3) %}
                  {% assign icon_setting = 'cell_' | append: forloop.index | append: '_icon' %}
                  {% assign content_setting = 'cell_' | append: forloop.index | append: '_content' %}
                  {% assign highlight_setting = 'cell_' | append: forloop.index | append: '_highlight' %}
                  <td class="{% if block.settings[highlight_setting] %}comparison-table__cell--highlighted{% endif %}">
                    {% if block.settings[icon_setting] == 'check' %}
                      {{ 'icon-table-check.svg' | inline_asset_content }}
                    {% else %}
                      {{ 'icon-table-cross.svg' | inline_asset_content }}
                    {% endif %}
                    <div class="rte {% if block.settings[highlight_setting] %}comparison-table__cell--highlighted{% endif %}">
                      {{ block.settings[content_setting] | newline_to_br }}
                    </div>
                  </td>
                {% endfor %}
              </tr>
            {% endif %}
          {% endfor %}
        </tbody>
      </table>
    </div>
  </div>
</div>
