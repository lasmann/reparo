{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}

{{ 'component-slider.css' | asset_url | stylesheet_tag }}
{{ 'template-collection.css' | asset_url | stylesheet_tag }}

{% if section.settings.image_shape == 'blob' %}
  {{ 'mask-blobs.css' | asset_url | stylesheet_tag }}
{%- endif -%}

{%- unless section.settings.quick_add == 'none' -%}
  {{ 'quick-add.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
{%- endunless -%}

{%- if section.settings.quick_add == 'standard' -%}
  <script src="{{ 'quick-add.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{%- if section.settings.quick_add == 'bulk' -%}
  <script src="{{ 'quick-add-bulk.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'quantity-popover.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'price-per-item.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'quick-order-list.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{%- style -%}
  #shopify-section-{{ section.id }} {
    overflow: hidden;
  }

  .section-{{ section.id }}-padding {
    padding-top: calc({{ section.settings.padding_top }}px * 0.75);
    padding-bottom: calc({{ section.settings.padding_bottom }}px  * 0.75);
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- liquid
  assign slider_loop = section.settings.slider_loop
  assign slider_effect = section.settings.slider_effect
  assign slider_speed = section.settings.slider_speed
  assign slider_mobile_slides_count = section.settings.slider_mobile_slides_count
  assign slider_mobile_center_slides = section.settings.slider_mobile_center_slides
  assign slider_mobile_slides_gap = section.settings.slider_mobile_slides_gap
  assign slider_enable_navigation = section.settings.slider_enable_navigation
  assign slider_enable_freescroll = section.settings.slider_enable_freescroll
  assign slider_tablet_slides_count = section.settings.slider_tablet_slides_count
  assign slider_tablet_center_slides = section.settings.slider_tablet_center_slides
  assign slider_tablet_slides_gap = section.settings.slider_tablet_slides_gap
  assign slider_desktop_slides_count = section.settings.slider_desktop_slides_count
  assign slider_desktop_center_slides = section.settings.slider_desktop_center_slides
  assign slider_desktop_slides_gap = section.settings.slider_desktop_slides_gap
  assign slider_pagination = section.settings.slider_pagination
-%}

{%- capture slider_options -%}
  {
    {% if slider_loop %}
      'loop': true,
      'loopAddBlankSlides': true,
    {% endif %}
    {% unless slider_effect == 'default' and slider_mobile_slides_count > 1 %}
      'effect': '{{ slider_effect }}',
      'crossFade': false,
    {% endunless %}
    'speed': {{ slider_speed }},
    'autoplay': false,
    'grabCursor': true,
    'slidesPerView': {{ slider_mobile_slides_count }},
    {% comment %} {% if section.settings.slider_grouped_slides %}
      'slidesPerGroup': {{ slider_mobile_slides_count }},
    {% endif %} {% endcomment %}
    {% unless slider_loop %}
      'centeredSlides': {{ slider_mobile_center_slides }},
    {% endunless %}
    'spaceBetween': {{ slider_mobile_slides_gap }},
    'mousewheel': {
      'forceToAxis': true,
      'thresholdDelta': 20
    },
    {% if slider_enable_navigation %}
      'navigation': {
        'prevEl': '#swiper-prev-button--{{ section.id }}',
        'nextEl': '#swiper-next-button--{{ section.id }}'
      },
    {% endif %}
    'breakpoints': {
      '750': {
        {% if slider_enable_freescroll %}
          {% comment %} 'freeMode': true, {% endcomment %}
          'cssMode': true,
        {% endif %}
        {% unless slider_effect == 'default' and slider_tablet_slides_count > 1 %}
          'effect': '{{ slider_effect }}',
          'crossFade': false,
        {% endunless %}
        'slidesPerView': {{ slider_tablet_slides_count }},
        {% comment %} {% if section.settings.slider_grouped_slides %}
          'slidesPerGroup': {{ slider_tablet_slides_count }},
        {% endif %} {% endcomment %}
        {% unless slider_loop %}
          'centeredSlides': {{ slider_tablet_center_slides }},
        {% endunless %}
        'spaceBetween': {{ slider_tablet_slides_gap }}
      },
      '1200': {
        {% unless slider_effect == 'default' and slider_desktop_slides_count > 1 %}
        'effect': '{{ slider_effect }}',
        'crossFade': false,
        {% endunless %}
        {% comment %} {% if section.settings.slider_grouped_slides %}
          'slidesPerGroup': {{ slider_desktop_slides_count }},
        {% endif %} {% endcomment %}
        'slidesPerView': {{ slider_desktop_slides_count }},
        {% unless slider_loop %}
          'centeredSlides': {{ slider_desktop_center_slides }},
        {% endunless %}
        'spaceBetween': {{ slider_desktop_slides_gap }}
      }
    },
    {%- if slider_pagination == 'bullets' -%}
      'pagination': {
        'el': '#swiper-pagination--{{ section.id }}'
      }
    {%- elsif slider_pagination == 'dynamic-bullets' -%}
      'pagination': {
        'el': '#swiper-pagination--{{ section.id }}',
        'dynamicBullets': true
      }
    {%- elsif slider_pagination == 'progress' -%}
      'scrollbar': {
        'el': '#swiper-scrollbar--{{ section.id }}'
      }
    {%- endif -%}
  }
{%- endcapture -%}

{% capture section_slides %}
    {%- for product in search.results -%}
    <li
    id="Slide-{{ section.id }}-{{ forloop.index }}"
    class="swiper-slide {% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
    data-swiper-slide
    {% if settings.animations_reveal_on_scroll %}
        data-cascade
        style="--animation-order: {{ forloop.index }};"
    {% endif %}
    > 
        {% render 'card-product',
            card_product: product,
            media_aspect_ratio: section.settings.image_ratio,
            image_shape: section.settings.image_shape,
            show_secondary_image: section.settings.show_secondary_image,
            show_vendor: section.settings.show_vendor,
            show_rating: section.settings.show_rating,
            skip_styles: true,
            section_id: section.id,
            quick_add: section.settings.quick_add
        %}
    </li>
{%- endfor -%}
{% endcapture %}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="section-{{ section.id }}-padding scroll-trigger animate--slide-in">
    <div class="page-width {% if section.settings.full_width %} page-width--full-width {% endif %}">
      <recently-viewed
        data-limit="{{ section.settings.product_limit }}"
        {% if request.page_type == 'product' %}
          data-exclude="{{ product.id }}"
        {% endif %}
        data-url="{{ routes.search_url }}?section_id={{ section.id }}&type=product"
      >
        {%- if search.performed and search.results_count > 0 -%}
          {% render 'section-header',
            heading: section.settings.heading,
            heading_size: section.settings.heading_size,
            heading_weight: section.settings.heading_weight,
            heading_html_tag: section.settings.heading_html_tag,
            desktop_content_position: section.settings.desktop_content_alignment,
            content_content_position: section.settings.content_alignment
          %}
          <div class="slider-wrapper {% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
            <swiper-slider
              class="testimonial-slider testimonial-slider--{{section.id}}"
              data-options="{{ slider_options }}"
              disable-auto-init
            >
              <div
                class="swiper {% unless section.settings.slider_clip_contents %} swiper--no-clip {% endunless %}"
                data-swiper
              >
                <ul class="swiper-wrapper list-unstyled">
                  {{ section_slides }}
                </ul>
              </div>
            </swiper-slider>
            {% if section.settings.slider_enable_navigation %}
              <div class="slider-wrapper__navigation">
                <button
                  id="swiper-prev-button--{{ section.id }}"
                  class="swiper-button full-unstyled-button"
                  data-type="prev"
                >
                  {{- 'icon-arrow.svg' | inline_asset_content -}}
                </button>
                <button
                  id="swiper-next-button--{{ section.id }}"
                  class="swiper-button full-unstyled-button"
                  data-type="next"
                >
                  {{- 'icon-arrow.svg' | inline_asset_content -}}
                </button>
              </div>
            {% endif %}
            {% if section.settings.slider_pagination == 'progress' and section.settings.slider_loop == false %}
              <div
                class="slider-wrapper__pagination swiper-pagination-nav swiper-scrollbar"
                id="swiper-scrollbar--{{ section.id }}"
              ></div>
            {% else %}
              <div
                class="slider-wrapper__pagination swiper-pagination-nav"
                id="swiper-pagination--{{ section.id }}"
              ></div>
            {% endif %}
          </div>
        {%- endif -%}
      </recently-viewed>
    </div>
  </div>
</div>

<script src="{{ 'recently-viewed.js' | asset_url }}" defer="defer"></script>

{% schema %}
